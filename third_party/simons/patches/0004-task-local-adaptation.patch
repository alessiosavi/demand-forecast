+"""Raw scoring-adapter inference and fev-compatible SQL, without a fev dependency."""
+
+import warnings
+
+import numpy as np
+import torch
+
+from simons import forecast_series
+from simons.training.adapt_data import raw_model
+
+
+def nanmean(values, axis=None):
+    with warnings.catch_warnings():
+        warnings.simplefilter("ignore", RuntimeWarning)
+        return np.nanmean(values, axis=axis)
+
+
+def sql(y_true, q_pred, past, levels, seasonality, epsilon=0.0, per_item=False):
+    """fev SQL per channel/quantile; default reduces item/time BEFORE quantiles/channels.
+
+    `past` contains [D,T] histories. Nonfinite scaled losses are excluded exactly
+    as fev.Metric._safemean; zero seasonal scales are not silently replaced.
+    """
+    scales = np.stack([nanmean(np.abs(p[:, seasonality:] - p[:, :-seasonality]), -1) for p in past])
+    scales = np.clip(scales, epsilon, None)
+    truth = y_true[..., None]
+    levels = np.asarray(levels)
+    loss = 2 * np.abs((truth - q_pred) * ((truth <= q_pred) - levels))
+    with np.errstate(divide="ignore", invalid="ignore"):
+        scaled = loss / scales[:, None, :, None]
+    scaled = np.where(np.isfinite(scaled), scaled, np.nan)
+    return nanmean(scaled, axis=1 if per_item else (0, 1))
+
+
+def metric_config(scoring):
+    metric = scoring["eval_metric"]
+    spec = {"name": metric} if isinstance(metric, str) else dict(metric)
+    if str(spec.pop("name")).upper() != "SQL" or set(spec) - {"epsilon"}:
+        raise ValueError("registered adaptation supports SQL (optional epsilon) only")
+    epsilon = float(spec.get("epsilon", 0.0))
+    levels = scoring["quantile_levels"]
+    if not np.isfinite(epsilon) or epsilon < 0 or not levels or not all(0 < q < 1 for q in levels):
+        raise ValueError("invalid SQL configuration")
+    if scoring["seasonality"] < 1:
+        raise ValueError("SQL seasonality must be positive")
+    return epsilon
+
+
+@torch.inference_mode()
+def evaluate(model, bundle, batch_size=4):
+    """Same forecast_series, blocks, raw switches, sorting and interpolation as SimonsAdapter."""
+    scoring = bundle.manifest["scoring"]
+    epsilon = metric_config(scoring)
+    levels = scoring["quantile_levels"]
+    windows = []
+    was_training = model.training
+    model.eval()
+    try:
+        with raw_model(model):
+            for inner in bundle.inners:
+                items = inner["items"]
+                if not items:
+                    windows.append(dict(score=None, groups=[], reason="empty_inner"))
+                    continue
+                blocks = [(item, block) for item in items for block in item["model_input"]]
+                outputs = forecast_series(
+                    model,
+                    [np.asarray(b["target"], dtype=np.float32) for _, b in blocks],
+                    bundle.horizon,
+                    future_covariates=[b["known_covariates"] for _, b in blocks],
+                    past_covariates=None,
+                    shared_categories=False,
+                    batch_size=batch_size,
+                )
+                if len(outputs) != len(blocks):
+                    raise ValueError("forecast group count mismatch")
+                predictions, groups = {}, []
+                nonfinite = False
+                for (item, block), output in zip(blocks, outputs, strict=True):
+                    q = np.sort(np.asarray(output), axis=-1)
+                    indices = block["target_indices"]
+                    if q.shape != (len(indices), bundle.horizon, 9):
+                        raise ValueError("forecast shape mismatch")
+                    nonfinite |= not bool(np.isfinite(q).all())
+                    q = np.stack(
+                        [
+                            np.apply_along_axis(
+                                lambda a: np.interp(level, np.arange(1, 10) / 10, a), -1, q
+                            )
+                            for level in levels
+                        ],
+                        axis=-1,
+                    )
+                    n = len(scoring["target_columns"])
+                    predictions.setdefault(
+                        item["item_id"], np.full((n, bundle.horizon, len(levels)), np.nan)
+                    )[indices] = q
+                if nonfinite:
+                    windows.append(dict(score=None, groups=[], reason="non_finite_forecast"))
+                    continue
+                truth = np.stack([np.asarray(i["score_target"], dtype=np.float64).T for i in items])
+                past = [np.asarray(i["score_past"], dtype=np.float64) for i in items]
+                q = np.stack([predictions[i["item_id"]].transpose(1, 0, 2) for i in items])
+                if not np.isfinite(q).all():
+                    raise ValueError("incomplete inner target blocks")
+                scores = sql(truth, q, past, levels, scoring["seasonality"], epsilon)
+                per_item = sql(truth, q, past, levels, scoring["seasonality"], epsilon, True).mean(
+                    -1
+                )
+                for j, item in enumerate(items):
+                    for block in item["model_input"]:
+                        indices = block["target_indices"]
+                        groups.append(
+                            dict(
+                                item_id=item["item_id"],
+                                target_indices=indices,
+                                score=number(np.mean(per_item[j, indices])),
+                            )
+                        )
+                windows.append(
+                    dict(
+                        score=number(np.mean(scores.mean(-1))),
+                        groups=groups,
+                        per_channel=[number(x) for x in scores.mean(-1)],
+                    )
+                )
+    finally:
+        model.train(was_training)
+    return windows
+
+
+def number(value):
+    return float(value) if np.isfinite(value) else None
+
+
+def select(evaluations):
+    """Literal registered dual-window gate; patience uses the mean and significant best."""
+    base = np.array([w["score"] for w in evaluations[0]["windows"]], dtype=float)
+    best, significant, stale, selected = float("inf"), float(base.mean()), 0, 0
+    for i, evaluation in enumerate(evaluations):
+        pair = np.array([w["score"] for w in evaluation["windows"]], dtype=float)
+        if pair.shape != (2,) or not np.isfinite(pair).all():
+            return dict(
+                selected_update=0, reason="non_finite_evaluation", stop=True, stale_checks=stale
+            )
+        if i == 0:
+            continue
+        mean = float(pair.mean())
+        # A zero baseline has no positive percentage gain to offer.
+        if (base > 0).all() and (pair <= base * 0.98).all() and mean < best:
+            best, selected = mean, evaluation["update"]
+        if significant > 0 and mean <= significant * 0.995:
+            significant, stale = mean, 0
+        else:
+            stale += 1
+        if stale >= 2:
+            break
+    return dict(
+        selected_update=selected,
+        reason="inner_gain" if selected else "no_qualifying_gain",
+        stop=stale >= 2,
+        stale_checks=stale,
+    )
