@@ -0,0 +1,214 @@
+"""Verified AD1 bundles, native grouped-window sampling and horizon-only loss."""
+
+import hashlib
+import json
+from contextlib import contextmanager
+from dataclasses import replace
+from pathlib import Path
+
+import numpy as np
+import torch
+
+from simons.model import QUANTILES, future_steps
+from simons.training import network
+
+RAW = dict(
+    views=False, sign_clip=False, integer_snap=False, fit_row=False, xreg=False, xreg_guard=False
+)
+
+
+def json_bytes(value):
+    return (
+        json.dumps(
+            value, sort_keys=True, ensure_ascii=False, separators=(",", ":"), allow_nan=False
+        )
+        + "\n"
+    ).encode()
+
+
+def sha(path):
+    digest = hashlib.sha256()
+    with Path(path).open("rb") as handle:
+        for block in iter(lambda: handle.read(1 << 20), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+@contextmanager
+def raw_model(model):
+    config = model.config
+    model.config = replace(config, **RAW)
+    try:
+        yield
+    finally:
+        model.config = config
+
+
+class Bundle:
+    """Only manifest-listed, hash-verified payloads beneath the supplied bundle are read."""
+
+    def __init__(self, root):
+        self.root = Path(root).resolve(strict=True)
+        manifest_path = (self.root / "manifest.json").resolve(strict=True)
+        if not manifest_path.is_relative_to(self.root):
+            raise ValueError("manifest path escapes bundle")
+        self.manifest = json.loads(manifest_path.read_bytes())
+        m = self.manifest
+        unsigned = {k: v for k, v in m.items() if k != "fingerprint"}
+        if m.get("schema_version") != 1 or hashlib.sha256(
+            json_bytes(unsigned)
+        ).hexdigest() != m.get("fingerprint"):
+            raise ValueError("bundle fingerprint/schema mismatch")
+        self.paths = {}
+        for name, expected in m["files"].items():
+            path = (self.root / name).resolve(strict=True)
+            if Path(name).is_absolute() or not path.is_relative_to(self.root):
+                raise ValueError("bundle path escapes bundle")
+            if path.stat().st_size != expected["bytes"] or sha(path) != expected["sha256"]:
+                raise ValueError(f"bundle payload hash mismatch: {name}")
+            self.paths[name] = path
+        self.inners = [json.loads(self.paths[f"inner-{i}.json"].read_bytes()) for i in range(2)]
+        if any(
+            x["scoring"] != m["scoring"] or x["origin_number"] != i
+            for i, x in enumerate(self.inners)
+        ):
+            raise ValueError("inner scoring/origin mismatch")
+        self.horizon = m["task"]["horizon"]
+        if not isinstance(self.horizon, int) or self.horizon < 1:
+            raise ValueError("invalid task horizon")
+
+    def sampler(self, config, context=2048):
+        return NativeSampler(self, config, context)
+
+
+class NativeSampler:
+    """Uniform item, then eligible block, then valid origin; no augmentations or mixing."""
+
+    def __init__(self, bundle, config, context):
+        import pyarrow.parquet as pq
+
+        self.horizon = bundle.horizon
+        if self.horizon > config.prediction_length:
+            raise ValueError("adaptation horizon exceeds the base native prediction length")
+        hist = min(context, config.context_length)
+        if hist > config.near_context:
+            hist = config.near_context + (
+                (hist - config.near_context) // (config.patch_length * config.far_pool)
+            ) * (config.patch_length * config.far_pool)
+        else:
+            hist = hist // config.patch_length * config.patch_length
+        self.history = hist
+        self.length = hist + future_steps(config)
+        if hist < 32:
+            raise ValueError("base/recipe context cannot hold 32 observed history points")
+        m = bundle.manifest
+        mappings = {g["native_item_id"]: g for g in m["groups"]}
+        excluded = {x["item_id"] for x in m["excluded_items"]}
+        cov_rows = {}
+        for name, path in sorted(bundle.paths.items()):
+            if name.startswith("covariates/train-") and name.endswith(".parquet"):
+                for row in pq.read_table(path).to_pylist():
+                    cov_rows[row["item_id"]] = row
+        self.items = {}
+        self.ineligible_groups = []
+        for name, path in sorted(bundle.paths.items()):
+            if not (name.startswith("univariate/train-") and name.endswith(".parquet")):
+                continue
+            for row in pq.read_table(path).to_pylist():
+                group = mappings[row["item_id"]]
+                if group["item_id"] in excluded:
+                    continue
+                y = np.asarray(row["target"], dtype=np.float32)
+                if y.ndim != 2 or not 1 <= len(y) <= 32:
+                    raise ValueError("invalid native target shape")
+                covs = np.empty((0, y.shape[-1]), dtype=np.float32)
+                if m["covariates"]["known_future"]:
+                    first = None
+                    for j, index in enumerate(group["target_indices"]):
+                        key = json.dumps([group["item_id"], index], separators=(",", ":"))
+                        entry = cov_rows[key]
+                        if not np.array_equal(
+                            y[j], np.asarray(entry["target"], dtype=np.float32), equal_nan=True
+                        ):
+                            raise ValueError("native covariate/target rows disagree")
+                        if first is None:
+                            first = entry["covariates"]
+                    covs = np.asarray(first, dtype=np.float32)
+                    if covs.shape != (len(m["covariates"]["known_future"]), y.shape[-1]):
+                        raise ValueError("invalid native known-covariate shape")
+                # Count finite points, never impute labels or inspect inner targets.
+                n = y.shape[-1]
+                origins = np.arange(32, n - self.horizon + 1, dtype=np.int64)
+                cumulative = np.pad(np.isfinite(y).cumsum(-1), ((0, 0), (1, 0)))
+                past = cumulative[:, origins] - cumulative[:, np.maximum(0, origins - hist)]
+                future = cumulative[:, origins + self.horizon] - cumulative[:, origins]
+                origins = origins[(past >= 32).all(0) & (future.sum(0) > 0)]
+                if not len(origins):
+                    self.ineligible_groups.append(group)
+                    continue
+                self.items.setdefault(group["item_id"], []).append((group, y, covs, origins))
+        self.keys = sorted(self.items)
+        self.unique_observed_values = sum(
+            int(np.isfinite(y).sum()) for groups in self.items.values() for _, y, _, _ in groups
+        )
+
+    def sample(self, rng):
+        groups = self.items[self.keys[int(rng.integers(len(self.keys)))]]
+        group, y, covs, origins = groups[int(rng.integers(len(groups)))]
+        origin = int(origins[int(rng.integers(len(origins)))])
+        start = max(0, origin - self.history)
+        lo = self.history - (origin - start)
+        end = origin + self.horizon
+        values = np.full((1, len(y), self.length), np.nan, dtype=np.float32)
+        values[0, :, lo : self.history + self.horizon] = y[:, start:end]
+        cov = covs[:, start:end]
+        # Match upstream's cap after discarding constant/all-missing columns.
+        finite = np.isfinite(cov)
+        low = np.where(finite, cov, np.inf).min(-1)
+        high = np.where(finite, cov, -np.inf).max(-1)
+        cov = cov[high > low][:16]
+        known = np.full((1, len(cov), self.length), np.nan, dtype=np.float32)
+        known[0, :, lo : self.history + self.horizon] = cov
+        return (
+            torch.from_numpy(values),
+            torch.from_numpy(known),
+            {
+                "native_item_id": group["native_item_id"],
+                "origin": origin,
+                "history_values": int(np.isfinite(y[:, start:origin]).sum()),
+                "supervised_values": int(np.isfinite(y[:, origin:end]).sum()),
+                "known_covariate_values": int(np.isfinite(cov).sum()),
+            },
+        )
+
+
+def horizon_loss(model, values, covariates, history, horizon):
+    """Masked-horizon pinball in the model's own causal-scale/asinh units.
+
+    Values are [B,V,history+native_future]. Only [history,history+H) is a label;
+    all later target AND covariate slots are absent from the forward pass.
+    """
+    patch = model.config.patch_length
+    position = torch.arange(values.shape[-1], device=values.device)
+    future = position >= history
+    supervised = future & (position < history + horizon)
+    inputs = values.masked_fill(future, float("nan"))
+    covariates = covariates.masked_fill(position >= history + horizon, float("nan"))
+    ids = torch.zeros(values.shape[:2], dtype=torch.long, device=values.device)
+    with raw_model(model):
+        q, loc, scale = network.covariate_forward(model, inputs, ids, covariates)
+    # The last history token predicts the first future patch. No history term exists.
+    first = q.shape[2] - future_steps(model.config) // patch - 1
+    patches = (horizon + patch - 1) // patch
+    prediction = q[:, :, first : first + patches].flatten(2, 3)[..., :horizon, :]
+    loc = loc[:, :, first : first + patches].repeat_interleave(patch, -1)[..., :horizon]
+    scale = scale[:, :, first : first + patches].repeat_interleave(patch, -1)[..., :horizon]
+    target = values[..., supervised].double()
+    observed = torch.isfinite(target)
+    goal = torch.asinh((torch.where(observed, target, 0) - loc) / scale).float()
+    err = goal.unsqueeze(-1) - prediction
+    levels = prediction.new_tensor(QUANTILES)
+    losses = torch.maximum(levels * err, (levels - 1) * err)
+    total = torch.where(observed.unsqueeze(-1), losses, 0).sum()
+    count = int(observed.sum())
+    return total / max(1, count * len(QUANTILES)), count
