+++ b/src/simons/training/reliability.py
@@ -0,0 +1,145 @@
+"""Distribution-correct restart streams, absolute role clocks and durable checkpoints."""
+
+import hashlib
+import json
+import os
+import pickle
+import random
+import socket
+from datetime import datetime, timezone
+from pathlib import Path
+
+import numpy as np
+import torch
+
+
+def reseed(seed, rank, step):
+    """Reset global streams; return a bounded seed for all fresh private streams.
+
+    The bound leaves room for upstream's affine private-generator seed offsets.
+    Pools, banks and worker iterators must be constructed *after* this call.
+    """
+    value = (
+        int.from_bytes(
+            hashlib.sha256(f"simons-spot-v1:{seed}:{rank}:{step}".encode()).digest()[:4], "little"
+        )
+        & 0x7FFFFFFF
+    )
+    random.seed(value)
+    np.random.seed(value)
+    torch.manual_seed(value)
+    if torch.cuda.is_available():
+        torch.cuda.manual_seed_all(value)
+    return value
+
+
+def seed_worker(_worker):
+    """Seed Python/NumPy/Torch in each loader worker from its private loader stream."""
+    from simons.synth import mech
+
+    mech.configure()  # Never inherit a parent trajectory bank into a worker.
+    value = torch.initial_seed()
+    random.seed(value)
+    np.random.seed(value % 2**32)
+    torch.manual_seed(value)
+
+
+def role_position(step, origin):
+    """Current and prefetched-pool role positions in the original leg's curriculum."""
+    return step - origin, max(step - 1, origin) - origin
+
+
+HASH_TRAILER = b"\nSIMONS-SHA256:"
+SNAPSHOT_NAMES = ("checkpoint-slot-0.pt", "checkpoint-slot-1.pt")
+FINAL_NAME = "checkpoint-final.pt"
+CHECKPOINT_NAMES = (*SNAPSHOT_NAMES, FINAL_NAME)
+
+
+def checkpoint_hash(path, required=True):
+    """Verify the SHA-256 footer covering all serialized bytes, including identity/step."""
+    path = Path(path)
+    trailer_size = len(HASH_TRAILER) + 64
+    with path.open("rb") as handle:
+        size = handle.seek(0, os.SEEK_END)
+        if size < trailer_size:
+            if not required:
+                return None
+            raise ValueError(f"missing checkpoint content hash: {path}")
+        handle.seek(-trailer_size, os.SEEK_END)
+        trailer = handle.read()
+        if not trailer.startswith(HASH_TRAILER):
+            if not required:
+                return None  # Upstream checkpoints outside durable state remain readable.
+            raise ValueError(f"missing checkpoint content hash: {path}")
+        handle.seek(0)
+        remaining = size - trailer_size
+        digest = hashlib.sha256()
+        while remaining:
+            block = handle.read(min(1 << 20, remaining))
+            if not block:
+                raise ValueError(f"truncated checkpoint: {path}")
+            digest.update(block)
+            remaining -= len(block)
+        value = digest.hexdigest()
+        if trailer[len(HASH_TRAILER) :] != value.encode():
+            raise ValueError(f"checkpoint content hash mismatch: {path}")
+        return value
+
+
+def latest_checkpoint(directory):
+    """Select by embedded absolute step after validation; names/mtimes carry no order."""
+    from simons.training.trainer import read_checkpoint
+
+    candidates = list(Path(directory).glob("checkpoint-*.pt"))
+    newest, newest_step = None, -1
+    for path in candidates:
+        if path.name not in CHECKPOINT_NAMES:
+            continue
+        try:
+            state = read_checkpoint(path)
+            required = {"model", "optimizer", "model_config", "training", "elapsed_seconds"}
+            step = state["step"]
+            if required <= state.keys() and type(step) is int and step > newest_step:
+                newest, newest_step = path, step
+        except (
+            OSError,
+            RuntimeError,
+            ValueError,
+            EOFError,
+            KeyError,
+            TypeError,
+            pickle.UnpicklingError,
+        ):
+            continue
+    if newest is not None:
+        return newest
+    if candidates:
+        raise ValueError(f"no valid committed checkpoint in {directory}; refusing a fresh run")
+    return None
+
+
+def prune_checkpoints(directory):
+    """A completed leg retains its stable final; remote slots remain bounded without deletes."""
+    directory = Path(directory)
+    if (directory / FINAL_NAME).is_file():
+        checkpoint_hash(directory / FINAL_NAME)
+        for name in SNAPSHOT_NAMES:
+            (directory / name).unlink(missing_ok=True)
+            (directory / (name + ".tmp")).unlink(missing_ok=True)
+
+
+def resume_record(directory, step):
+    """Record each restart in the experiment's durable append-only log."""
+    with (Path(directory) / "resume-log.jsonl").open("a") as handle:
+        handle.write(
+            json.dumps(
+                {
+                    "step": step,
+                    "utc": datetime.now(timezone.utc).isoformat(),
+                    "host": socket.gethostname(),
+                }
+            )
+            + "\n"
+        )
+        handle.flush()
+        os.fsync(handle.fileno())
