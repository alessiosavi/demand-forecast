@@ -0,0 +1,168 @@
+"""Condition and provisional receipt contracts, independent of training dependencies."""
+
+import json
+import math
+import re
+from pathlib import Path
+
+OVERRIDE_LEGS = {
+    "covariate_weight": ("stage3", "stage4", "stage4-long"),
+    "covariate_mix": ("stage3", "stage4", "stage4-long"),
+    "long_weight": ("stage4", "stage4-long"),
+}
+
+
+def canonical_condition(name, overrides):
+    """Encode the closed set of fork overrides independently of input spelling."""
+    if name is None and not overrides:
+        return None
+    if name is None or not overrides:
+        raise ValueError("condition and overrides require both or neither")
+    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,31}", name):
+        raise ValueError("invalid condition name")
+    values = {}
+    for item in overrides:
+        key, separator, value = item.partition("=")
+        if not separator or key not in OVERRIDE_LEGS or key in values:
+            raise ValueError("unknown or duplicate override key")
+        try:
+            numbers = [float(x) for x in value.split(",")]
+        except ValueError as error:
+            raise ValueError("override must contain finite numbers") from error
+        if not all(math.isfinite(x) for x in numbers):
+            raise ValueError("override must contain finite numbers")
+        if key == "covariate_mix":
+            if (
+                len(numbers) != 3
+                or any(x < 0 or x > 1 for x in numbers)
+                or abs(sum(numbers) - 1) > 1e-9
+            ):
+                raise ValueError("covariate_mix requires three shares summing to one")
+        elif len(numbers) != 1 or not 0 < numbers[0] <= 1:
+            raise ValueError("override weight must be in (0, 1]")
+        values[key] = ",".join(repr(x) for x in numbers)
+    return {"name": name, "overrides": dict(sorted(values.items()))}
+
+
+def validate_fork_options(size, leg, recipe, condition, override, attempt, unsafe, corpus_uri):
+    result = canonical_condition(condition, override)
+    if result is not None or attempt is not None:
+        if (
+            size != "25m"
+            or recipe != "full"
+            or leg not in (*OVERRIDE_LEGS["covariate_weight"], "export")
+        ):
+            raise ValueError("fork flags require 25m full stage3, stage4, stage4-long or export")
+    if attempt is not None:
+        if not isinstance(attempt, str) or not attempt.strip():
+            raise ValueError("provisional attempt id must be nonempty")
+        if unsafe:
+            raise ValueError("provisional and qualification corpus flags are mutually exclusive")
+        if not corpus_uri:
+            raise ValueError("provisional receipt requires a corpus URI")
+    return result
+
+
+class ForkIdentityError(ValueError):
+    """A provenance refusal must never be treated as recoverable artifact damage."""
+
+
+def job_condition(args):
+    return validate_fork_options(
+        getattr(args, "size", None),
+        getattr(args, "leg", None),
+        getattr(args, "recipe", "full"),
+        getattr(args, "condition", None),
+        getattr(args, "override", None),
+        getattr(args, "provisional_unaudited_corpus_attempt", None),
+        getattr(args, "unsafe_qualification_allow_unaudited_corpus", False),
+        getattr(args, "corpus_uri", None),
+    )
+
+
+def provisional_receipt(args):
+    attempt = getattr(args, "provisional_unaudited_corpus_attempt", None)
+    if attempt is None:
+        return None
+    uri = getattr(args, "corpus_uri", None)
+    if not isinstance(uri, str) or not re.fullmatch(r"gs://[A-Za-z0-9._-]+(?:/[^\r\n]*)?", uri):
+        raise ValueError("provisional receipt requires a corpus URI")
+    return {
+        "provisional": True,
+        "warning": "UNAUDITED_CORPUS_PROVISIONAL",
+        "attempt_id": attempt,
+        "corpus_uri": uri.rstrip("/"),
+    }
+
+
+def check_fork_identity(saved, args, predecessor=False):
+    condition = job_condition(args)
+    # This exception is only for a fresh stage3's synthetic stage2 parent.
+    stage2_parent = (
+        predecessor
+        and getattr(args, "leg", None) == "stage3"
+        and saved.get("leg") == "stage2"
+        and saved.get("condition") is None
+        and saved.get("corpus_release") is None
+    )
+    if saved.get("condition") != condition and not stage2_parent:
+        raise ForkIdentityError("condition identity changed; use a separate STATE_URI")
+    receipt = saved.get("corpus_release")
+    desired = provisional_receipt(args)
+    if desired is not None or (receipt or {}).get("provisional"):
+        if receipt != desired and not stage2_parent:
+            raise ForkIdentityError(
+                "provisional receipt identity changed; use a separate STATE_URI"
+            )
+
+
+def agree(records):
+    """No condition/provisional migration; retain the old missing-to-audited exception."""
+    if not records:
+        return
+    condition = records[0].get("condition")
+    receipts = [r.get("corpus_release") for r in records]
+    if any(r.get("condition") != condition for r in records):
+        raise ForkIdentityError("condition identity changed: records disagree")
+    strict = condition is not None or any((r or {}).get("provisional") for r in receipts)
+    compared = receipts if strict else [r for r in receipts if r is not None]
+    if compared and any(r != compared[0] for r in compared):
+        raise ForkIdentityError("corpus receipt identity changed: records disagree")
+
+
+def check_records(directory, args=None, embedded=None):
+    """Read authoritative metadata before any recovery writes or no-op decisions."""
+    root = Path(directory)
+    records = []
+    for name in ("identity.json", "completed.json"):
+        try:
+            record = json.loads((root / name).read_text())
+        except (OSError, ValueError):
+            continue  # Artifact recovery may repair an absent or interrupted JSON file.
+        if name == "identity.json":
+            records.append(record)
+            continue
+        nested = record.get("job_identity")
+        if nested is not None:
+            records.append(nested)
+        if "condition" in record or "corpus_release" in record:
+            records.append(
+                {
+                    "condition": record.get("condition"),
+                    "corpus_release": record.get("corpus_release"),
+                }
+            )
+        members = record.get("member_job_identities", [])
+        records.extend(members)
+        if "member_corpus_releases" in record:
+            records.extend(
+                {"condition": record.get("condition"), "corpus_release": receipt}
+                for receipt in record["member_corpus_releases"]
+            )
+    if embedded is not None:
+        records.append(embedded)
+    agree(records)
+    if args is not None:
+        for record in records:
+            check_fork_identity(record, args)
+    return records
