@@ -0,0 +1,110 @@
+"""GPU qualification telemetry without changing batch, context or optimizer recipes."""
+
+import resource
+import sys
+import threading
+import time
+from pathlib import Path
+
+import torch
+
+
+def host_rss():
+    """Sample resident bytes for this process tree on Linux; self high-water elsewhere."""
+    proc = Path("/proc")
+    if not proc.is_dir():
+        value = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
+        return int(value if sys.platform == "darwin" else value * 1024)
+    import os
+
+    pending, total = [os.getpid()], 0
+    while pending:
+        pid = pending.pop()
+        try:
+            for line in (proc / str(pid) / "status").read_text().splitlines():
+                if line.startswith("VmRSS:"):
+                    total += int(line.split()[1]) * 1024
+            children = proc / str(pid) / "task" / str(pid) / "children"
+            pending.extend(int(p) for p in children.read_text().split())
+        except (OSError, ValueError):
+            continue
+    return total
+
+
+class Measurement:
+    """Measure exactly N complete updates after a warm-up, synchronizing CUDA boundaries."""
+
+    def __init__(self, warmup=20, updates=500):
+        self.warmup, self.updates = warmup, updates
+        self.done = self.measured = self.values = 0
+        self.seconds = self.wait = 0.0
+        self.peak_host = self.peak_gpu = self.peak_reserved = 0
+        self.stop = threading.Event()
+        self.monitor = None
+        self.first_step = self.last_step = None
+
+    @staticmethod
+    def sync(device):
+        if device.type == "cuda":
+            torch.cuda.synchronize(device)
+
+    def begin(self, device):
+        self.sync(device)
+        if self.done == self.warmup:
+            if device.type == "cuda":
+                torch.cuda.reset_peak_memory_stats(device)
+            self.monitor = threading.Thread(target=self.sample_host, daemon=True)
+            self.monitor.start()
+        self.started = time.perf_counter()
+
+    def generated(self, device):
+        self.sync(device)
+        self.generated_seconds = time.perf_counter() - self.started
+
+    def end(self, device, step, supervised, auxiliary_wait=0.0):
+        self.sync(device)
+        seconds = time.perf_counter() - self.started
+        if self.warmup <= self.done < self.warmup + self.updates:
+            self.measured += 1
+            self.seconds += seconds
+            self.wait += self.generated_seconds + auxiliary_wait
+            self.values += supervised
+            self.peak_host = max(self.peak_host, host_rss())
+            if device.type == "cuda":
+                self.peak_gpu = max(self.peak_gpu, torch.cuda.max_memory_allocated(device))
+                self.peak_reserved = max(self.peak_reserved, torch.cuda.max_memory_reserved(device))
+            self.first_step = step - 1 if self.first_step is None else self.first_step
+            self.last_step = step
+        self.done += 1
+
+    def sample_host(self):
+        while not self.stop.is_set():
+            self.peak_host = max(self.peak_host, host_rss())
+            self.stop.wait(0.05)
+
+    def close(self):
+        self.stop.set()
+        if self.monitor is not None:
+            self.monitor.join(timeout=1)
+
+    def result(self):
+        self.close()
+        if self.measured != self.updates:
+            raise ValueError(
+                f"qualification measured {self.measured}, expected {self.updates} updates"
+            )
+        return {
+            "measured_updates": self.measured,
+            "warmup_updates": self.warmup,
+            "first_step": self.first_step,
+            "last_step": self.last_step,
+            "peak_gpu_allocated_bytes": self.peak_gpu,
+            "peak_gpu_reserved_bytes": self.peak_reserved,
+            "peak_host_rss_bytes": self.peak_host,
+            "host_memory_method": "50ms sampled process-tree RSS on Linux; self high-water elsewhere",
+            "updates_per_second": self.measured / self.seconds,
+            "supervised_values_per_second": self.values / self.seconds,
+            "supervised_values": self.values,
+            "loader_generator_wait_share": self.wait / self.seconds,
+            "measured_seconds": self.seconds,
+        }
