new file mode 100644
--- /dev/null
+++ b/src/simons/training/exposure.py
@@ -0,0 +1,130 @@
+"""Scalar target exposure at loss hooks, separate from quantiles and loss weights.
+
+Counts describe consumed model windows after augmentation. Original corpus row,
+source and augmentation ancestry multiplicities are not available at these hooks.
+"""
+
+import copy
+
+import torch
+
+KEYS = ("E_real", "E_synthetic", "S_real", "S_synthetic", "covariate_values", "channel_windows")
+MISSING = [
+    "source rows drawn before packing/replacement and per-source/detailed-role breakdown",
+    "original input ancestry multiplicity inside real mixup/stitching",
+    "work and billed time absent from restored telemetry",
+]
+
+
+class Counts:
+    def __init__(self, saved=None, legacy=False):
+        self.value = (
+            copy.deepcopy(saved)
+            if saved is not None
+            else {
+                "schema": "simons-exposure-1",
+                **dict.fromkeys(KEYS, 0),
+                "updates_attempted": 0,
+                "optimizer_updates": 0,
+                "replay": {
+                    "known_updates": 0,
+                    "lost_telemetry": "unknown",
+                    **dict.fromkeys(KEYS, 0),
+                },
+                "missing": MISSING + (["exposure before legacy checkpoint"] if legacy else []),
+            }
+        )
+
+    def add(self, **values):
+        for key, value in values.items():
+            self.value[key] += int(value)
+
+    def merge(self, other):
+        self.add(**{key: other.value[key] for key in KEYS})
+
+    def snapshot(self):
+        return copy.deepcopy(self.value)
+
+
+def main_counts(
+    counts, inputs, sequence, target, source, far_len, far_tokens, patch, synthetic_rows, roles
+):
+    """E is input/eligible-label union per target window; S is post-packing labels.
+
+    Far values participate in front-end normalization even with far attention off.
+    Packing removes leading padding, never finite positions of a valid window.
+    """
+    from simons.training.packing import gather
+
+    b, v, length = sequence.shape
+    synthetic = torch.zeros((b, v), dtype=torch.bool, device=sequence.device)
+    if synthetic_rows:
+        synthetic[-synthetic_rows:] = True
+    if roles is not None and hasattr(roles, "exposure_synthetic"):
+        synthetic |= roles.exposure_synthetic
+    target_role = torch.ones_like(synthetic) if roles is None else ~roles.role
+    admitted = torch.isfinite(inputs)
+    # Prediction token j supervises raw near patch j+1. Align labels to raw time.
+    eligible = torch.zeros_like(admitted)
+    eligible[..., far_len + patch :] = torch.isfinite(target[..., far_tokens:-1, :]).flatten(-2)
+    exposed = (admitted | eligible) & target_role[..., None]
+    # Ignore unused slots (IDs -1), including any finite filler values.
+    tokens = target.shape[2]
+    active = torch.zeros(b * v * tokens, dtype=torch.bool, device=sequence.device)
+    active[source[source >= 0]] = True
+    active = active.reshape(b, v, tokens).any(-1)
+    exposed &= active[..., None]
+    counts.add(
+        E_real=(exposed & ~synthetic[..., None]).sum(),
+        E_synthetic=(exposed & synthetic[..., None]).sum(),
+        covariate_values=(admitted & ~target_role[..., None] & active[..., None]).sum(),
+        channel_windows=(exposed.any(-1)).sum(),
+    )
+    labels = torch.isfinite(gather(target.reshape(-1, patch), source, float("nan")))
+    ancestry = synthetic[..., None].expand(b, v, tokens).reshape(-1)
+    packed_synthetic = gather(ancestry, source, False)
+    counts.add(
+        S_real=(labels & ~packed_synthetic[:, None]).sum(),
+        S_synthetic=(labels & packed_synthetic[:, None]).sum(),
+    )
+
+
+def auxiliary_counts(counts, batch, history_weight, weight):
+    """All auxiliary targets are real-derived, including effects.synthetic(base,...)."""
+    if weight <= 0:
+        return
+    patch = 32
+    values, future = batch["values"], batch["future"]
+    inputs = values.masked_fill(future[:, None], float("nan"))
+    observed = torch.isfinite(values.unflatten(-1, (-1, patch))[:, :, 1:])
+    seen = torch.isfinite(inputs).unflatten(-1, (-1, patch)).any(-1).cummax(-1).values
+    supervised = observed & seen[..., :-1, None]
+    if history_weight <= 0:
+        fut = future.unflatten(-1, (-1, patch))[:, 1:].any(-1)
+        supervised &= fut[:, None, :, None]
+    eligible = torch.zeros_like(values, dtype=torch.bool)
+    eligible[..., patch:] = supervised.flatten(-2)
+    exposed = torch.isfinite(inputs) | eligible
+    counts.add(
+        E_real=exposed.sum(),
+        S_real=supervised.sum(),
+        covariate_values=torch.isfinite(batch["covs"]).sum(),
+        channel_windows=exposed.any(-1).sum(),
+    )
+
+
+def resume_high_water(counts, directory, step):
+    """Surviving JSONL records give a lower bound on work repeated after rollback."""
+    import json
+    from pathlib import Path
+
+    replay = counts.value["replay"]
+    high = max(step, replay.get("observed_high_water_step", step))
+    for path in Path(directory).rglob("training.jsonl"):
+        for line in path.read_text().splitlines():
+            try:
+                high = max(high, int(json.loads(line).get("step", step)))
+            except (ValueError, TypeError):
+                pass  # A partially uploaded final JSONL record is unknown telemetry.
+    replay["observed_high_water_step"] = high
+    replay["restored_step"] = step
