diff --git a/src/simons/training/screen.py b/src/simons/training/screen.py
new file mode 100644
--- /dev/null
+++ b/src/simons/training/screen.py
@@ -0,0 +1,125 @@
+"""Registered screen clocks, corpus release receipts and compatible run identities."""
+
+import copy
+import hashlib
+import json
+from pathlib import Path
+
+FULL_UPDATES = 120208
+
+
+def screen_settings(root, leg, updates):
+    """Round absolute clocks; put total-rounding residual in the long mixed leg.
+
+    The registered 12M/25M screen uses 25M clocks. Sampling mechanics are never scaled.
+    """
+    import yaml
+
+    if type(updates) is not int or updates < 100:
+        raise ValueError("screen updates must be an integer >= 100")
+    s = yaml.safe_load((Path(root) / f"configs/simons-25m-{leg}.yaml").read_text())["training"]
+
+    def scale(n):
+        return round(n * updates / FULL_UPDATES)
+
+    lengths = [scale(n) for n in (65000, 12000, 4000, 8000)]
+    end = scale(57600)
+    start = end - (updates - sum(lengths))
+    middle = scale(39957)
+    if not 0 < start < middle < end:
+        raise ValueError("screen budget cannot represent the context phases")
+    out = {}
+    if leg in ("stage1", "stage2"):
+        out["steps"] = lengths[0 if leg == "stage1" else 1]
+        for key in ("warmup_steps", "decay_steps", "rewarm_steps"):
+            if key in s:
+                out[key] = max(1, scale(s[key]))
+    else:
+        out.update(
+            steps=end,
+            warm_start_step=start
+            if leg == "stage3"
+            else end - lengths[2 if leg == "stage4" else 3],
+            context_schedule=f"8192:{start / end:.16f},7680:{(middle - start) / end:.16f},"
+            f"32768:{(end - middle) / end:.16f}",
+        )
+        for key in ("rewarm_steps", "synthetic_ramp_steps"):
+            out[key] = max(1, scale(s[key]))
+        # These dimensionless WSD parameters retain their fractions.
+        for key in ("warmup_fraction", "decay_fraction"):
+            if key in s:
+                out[key] = s[key]
+    return out
+
+
+def corpus_release(corpus, qualification_only=False):
+    """Fail closed on the corpus-v4 release handshake; hash the exact audit bytes."""
+    if qualification_only:
+        return {"qualification_only": True, "warning": "UNSAFE_UNAUDITED_CORPUS"}
+    try:
+        root = Path(corpus)
+        status = json.loads((root / "attempt-status.json").read_bytes())
+        data = (root / "audit.json").read_bytes()
+        audit = json.loads(data)
+        attempt = status["attempt_id"]
+        if not isinstance(attempt, str) or not attempt.strip():
+            raise ValueError("missing attempt id")
+        if (
+            status.get("complete") is not True
+            or type(status.get("exit_code")) is not int
+            or status["exit_code"] != 0
+        ):
+            raise ValueError("attempt is incomplete or failed")
+        if audit.get("attempt_id") != attempt or audit.get("valid") is not True:
+            raise ValueError("audit is invalid or belongs to another attempt")
+        if type(audit.get("exit_code")) is not int or audit["exit_code"] != 0:
+            raise ValueError("audit exited nonzero")
+        folders = audit["folders"]
+        if (
+            not isinstance(folders, list)
+            or not folders
+            or not any(f["status"] == "allowed" for f in folders)
+        ):
+            raise ValueError("audit has no allowed folders")
+        if any(f["status"] == "allowed" and f["verdict"] != "clean" for f in folders):
+            raise ValueError("an allowed folder is not clean")
+        return {"attempt_id": attempt, "audit_sha256": hashlib.sha256(data).hexdigest()}
+    except (OSError, ValueError, KeyError, TypeError, AttributeError) as error:
+        raise ValueError(f"corpus audit gate: {error}") from error
+
+
+def mode(args):
+    name = getattr(args, "recipe", "full")
+    updates = getattr(args, "screen_updates", None)
+    return name, (25000 if updates is None else updates) if name == "screen" else None
+
+
+def check_identity(saved, args):
+    """Legacy identities mean full; provenance revisions may change across legs."""
+    if saved.get("qualification_only") or saved.get("corpus_release", {}).get("qualification_only"):
+        raise ValueError("qualification-only output cannot be a predecessor")
+    name, updates = mode(args)
+    if (saved.get("recipe_name", "full"), saved.get("screen_updates")) != (name, updates):
+        raise ValueError("recipe identity changed; use a separate STATE_URI")
+    for key in ("size", "seed", "upstream_pin"):
+        if hasattr(args, key) and saved.get(key) != getattr(args, key):
+            raise ValueError(f"experiment identity changed: {key}")
+    if (
+        getattr(args, "leg", None) != "export"
+        and saved.get("corpus_uri") is not None
+        and hasattr(args, "corpus_uri")
+    ):
+        if saved["corpus_uri"] != args.corpus_uri:
+            raise ValueError("corpus identity changed")
+
+
+def compatible_resume(saved, expected):
+    """Retain original full-run provenance, adding the first audited receipt if absent."""
+    old, new = copy.deepcopy(saved), copy.deepcopy(expected)
+    for key in ("repo_sha", "bundle_sha256"):
+        new[key] = old.get(key)
+    if "corpus_release" not in old and "corpus_release" in new:
+        old["corpus_release"] = new.get("corpus_release")
+    if old != new:
+        raise ValueError("experiment identity changed; use a separate STATE_URI")
+    return new
